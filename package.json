{
  "name": "@jvorndran/fbs-cli",
  "version": "1.2.0",
  "description": "Query all 71 CollegeFootballData GET endpoints and build fresh cutoff-safe team analytics in deterministic YAML",
  "keywords": [
    "college-football",
    "cfbd",
    "cli",
    "sports-data",
    "typescript",
    "yaml",
    "read-only",
    "agent-cli"
  ],
  "homepage": "https://jvorndran.github.io/fbs-cli/",
  "bugs": {
    "url": "https://github.com/jvorndran/fbs-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvorndran/fbs-cli.git"
  },
  "author": {
    "name": "Jacob Vorndran",
    "url": "https://github.com/jvorndran"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "fbs": "./dist/fbs.js"
  },
  "files": [
    "dist/fbs.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/fbs-cli/SKILL.md",
    "skills/fbs-cli/references/command-index.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun run test:offline",
    "test:offline": "CFBD_LIVE_TESTS=0 bun test",
    "test:coverage": "CFBD_LIVE_TESTS=0 bun test --coverage && bun run ./scripts/check-coverage.ts",
    "test:live": "CFBD_LIVE_TESTS=1 bun test tests/live",
    "test:node": "node ./tests/node-smoke.mjs",
    "test:native": "node ./scripts/native-smoke.mjs",
    "test:pack": "node ./scripts/check-pack.mjs",
    "typecheck": "tsc --noEmit",
    "check:docs": "node ./scripts/check-doc-contract.mjs",
    "check:release-tag": "node ./scripts/check-release-tag.mjs",
    "check:release": "bun run typecheck && bun run test:offline && bun run check:docs && bun run build:npm && bun run test:node && bun run test:pack",
    "build": "bun run build:npm",
    "build:npm": "bun build ./src/cli.ts --target=node --external commander --external yaml --external zod --outfile ./dist/fbs.js",
    "build:native": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile ./dist/fbs",
    "prepack": "bun run typecheck && bun run test:offline && bun run check:docs && bun run build:npm && bun run test:node"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "0.6.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "cfbd": "5.21.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14"
}
