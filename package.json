{
  "name": "fbs-cli",
  "version": "0.1.0",
  "description": "Agent-first, read-only CLI for the CollegeFootballData API",
  "type": "module",
  "private": true,
  "bin": {
    "fbs": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:live": "CFBD_LIVE_TESTS=1 bun test tests/live",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --compile --outfile ./dist/fbs"
  },
  "dependencies": {
    "cfbd": "5.21.0",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
