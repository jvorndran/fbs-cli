{
  "name": "@jvorndran/fbs-cli",
  "version": "0.2.1",
  "description": "Explore the CollegeFootballData API from your terminal with clean YAML output",
  "keywords": [
    "college-football",
    "cfbd",
    "cli",
    "sports-data"
  ],
  "homepage": "https://github.com/jvorndran/fbs-cli#readme",
  "bugs": {
    "url": "https://github.com/jvorndran/fbs-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvorndran/fbs-cli.git"
  },
  "type": "module",
  "bin": {
    "fbs": "./dist/fbs.js"
  },
  "files": [
    "dist/fbs.js"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "test:live": "CFBD_LIVE_TESTS=1 bun test tests/live",
    "test:node": "node ./tests/node-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:npm",
    "build:npm": "bun build ./src/cli.ts --target=node --packages=external --outfile ./dist/fbs.js",
    "build:native": "bun build ./src/cli.ts --compile --outfile ./dist/fbs",
    "prepack": "bun run typecheck && bun test && bun run build:npm && bun run test:node"
  },
  "dependencies": {
    "cfbd": "5.21.0",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14"
}
